<img src="/images/img/backgroundlogin.png" loading="eager" style="display:none;" id="preloadImage">
<div class="search" style="background-image: url('/images/img/backgroundlogin.png');">
    <div class="search-box container">
        <div class="search-til color-white">
            <h1 class="search-til-top">
                <span>Săn Tìm Ứng Viên Miễn Phí </span>
                <br>
                <span class="fw-600">Giải Pháp Tuyển Dụng Hiệu Quả</span>
            </h1>
        </div>
        <div class="search-form d-flex flex-wr">
            <div class="search-name d-flex align-c gap-2 bg-white">
                <span><img width="24" height="24" alt="Search Icon" src="/images/icon/searchicon.svg"></span>
                <input class="fw-6" id="s_key" type="text" placeholder="Tên công việc" value="<%=name ||''%>">
                <input type="text" style="display: none;" id="city_input" value="<%=city%>">
            </div>
            <div class="search-loc d-flex align-c gap-2 bg-white">
                <span><img width="24" height="24" alt="Search Location" src="/images/icon/search_location.svg"></span>
                <label for="s_loc" class="visually-hidden">Chọn thành phố:</label>
                <select id="s_loc">
                    <option value=""></option>
                    <% if (listCities && listCities.length > 0) { %>
                        <% listCities.forEach(function(item) { %>
                            <option value="<%= item.cit_id %>"><%= item.cit_name %></option>
                        <% }); %>
                    <% } %>
                </select>
            </div>
            <button class="search-btn fw-700 color-white">
                Tìm kiếm
            </button>
        </div>
        <div class="search-ai bg-white">
            <div class="search-ai-header">
                <span class="search-ai-badge">AI</span>
                <span class="search-ai-title">Lọc ứng viên bằng ngôn ngữ tự nhiên</span>
            </div>
            <div class="search-ai-control d-flex align-c gap-2">
                <input id="ai_prompt" type="text" value="<%= typeof aiPrompt !== 'undefined' ? aiPrompt || '' : '' %>" placeholder="VD: Backend Node.js ở Hà Nội, trên 2 năm kinh nghiệm, lương từ 15 triệu">
                <button type="button" class="search-ai-btn fw-700 color-white">Lọc AI</button>
            </div>
            <p class="search-ai-hint">AI sẽ tự hiểu từ khóa, địa điểm, ngành nghề, kinh nghiệm và mức lương phù hợp.</p>
        </div>
    </div>
</div>
<script src="/js/search_job.js"></script>
